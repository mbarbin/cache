# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Package to regroup dev targets, documentation, and more"
maintainer: ["Mathieu Barbin <opensource@mbarbin.org>"]
authors: ["Mathieu Barbin"]
license: "ISC"
homepage: "https://github.com/mbarbin/cache"
bug-reports: "https://github.com/mbarbin/cache/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.2"}
  "ocamlformat" {= "0.29.0"}
  "bisect_ppx" {>= "2.8.3"}
  "ppx_expect" {>= "v0.17"}
  "ppx_js_style" {>= "v0.17"}
  "pulicomv" {= version}
  "pulicomv-tests" {= version}
  "odoc" {>= "2.4.4"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mbarbin/cache.git"
x-maintenance-intent: ["(latest)"]
